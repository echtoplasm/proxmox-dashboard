{
  "name": "proxmox-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Touch-optimized Proxmox VE cluster dashboard",
  "main": "server.js",
  "scripts": {
    "server": "node server.js",
    "client": "PORT=3000 react-scripts start",
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm run server\" \"npm run client\"",
    "build": "react-scripts build",
    "start": "node server.js",
    "test": "react-scripts test"
  },
  "proxy": "http://localhost:5000",
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
